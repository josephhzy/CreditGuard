# CreditGuard Environment Configuration
# Copy to .env and fill in values. All variables here are OPTIONAL; the
# code falls back to the defaults shown in comments.

# Kaggle credentials — required only for `make download`. Get the API token
# from https://www.kaggle.com/settings → "Create New Token" (downloads
# kaggle.json with these two fields). You must also accept the competition
# rules at https://www.kaggle.com/c/home-credit-default-risk/rules.
KAGGLE_USERNAME=your_username
KAGGLE_KEY=your_api_key

# MLflow tracking store. Read by the mlflow library itself; the project
# also reads `mlflow.tracking_uri` from config/train.yaml (default `mlruns/`).
# Setting this env var overrides the config value.
MLFLOW_TRACKING_URI=mlruns/

# Model serving — read by `serving.app._load_model` and related lifespan code.
# MODEL_PATH points to the champion bundle pickle produced by `training/train.py`
# (a dict with keys: model, scaler, calibrator, feature_names, model_type).
# `scripts/fit_calibrator.py` patches in the calibrator if the bundle predates
# that field. The Docker image copies `artifacts/` so this path resolves inside
# the container as well.
MODEL_PATH=artifacts/lightgbm_model.pkl
FEATURE_SCHEMA_PATH=config/feature_schema.yaml
# FEATURE_LOOKUP_PATH backs the demo `/predict` path that resolves engineered
# features by SK_ID_CURR. Production callers should send `engineered_features`
# directly and can leave this unset.
FEATURE_LOOKUP_PATH=data/processed/features.parquet
# CORS_ORIGINS is a comma-separated list of origins allowed by the FastAPI
# CORS middleware. Default `*` permits all origins; tighten in production.
CORS_ORIGINS=*
